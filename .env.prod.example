# Serverdə `.env` adı ilə saxlanılır — repoya commit EDİLMİR.
# İstifadə: docker compose -f docker-compose.prod.yml --env-file .env up -d --build
# Qdrant və Postgres container adları ilə çağırılır (docker-compose.prod.yml-dəki
# `academate-backend_academate` şəbəkəsi üzərindən).

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_API_VERSION=2024-02-01

GROQ_API_KEY=

QDRANT_URL=http://rag-qdrant:6333
QDRANT_API_KEY=
COLLECTION_NAME=acadamate_docs

# academate-backend → bu servisə eyni açarla müraciət edir (X-API-Key header)
RAG_API_KEY=

# academate-db konteynerində ayrı DB (bax: server setup qeydləri)
POSTGRES_URL=postgresql://academate:<POSTGRES_PASSWORD>@academate-db:5432/acadamate_rag
